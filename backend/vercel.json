{
  "installCommand": "uv pip install -r requirements-vercel.txt --system",
  "functions": {
    "expense_api.py": {
      "excludeFiles": "{chroma_db/**,__pycache__/**,*.pdf,*.db,main.py,frontend.py,rag_app.py,resume_analyzer.py,portfolio.py}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/expense_api.py"
    }
  ]
}